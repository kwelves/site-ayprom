# Публичные настройки Supabase. Они встраиваются в клиентский bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Только сервер. Никогда не добавляйте NEXT_PUBLIC_ к этим переменным.
SUPABASE_SECRET_KEY=your-secret-key
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Мониторинг ошибок (Sentry). Необязательно: без DSN Sentry.init() ничего не
# делает, сборка и работа сайта не ломаются. Создайте бесплатный проект на
# sentry.io и вставьте DSN сюда и в NEXT_PUBLIC_SENTRY_DSN ниже.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Нужны только для загрузки source maps при `next build` (читаемые стектрейсы
# в проде) — необязательно для базовой отправки ошибок.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Секрет расписания уборки промежуточных загрузок. Vercel подставляет его
# в заголовок Authorization при запуске по расписанию; без него служебный
# адрес /api/cron/cleanup-product-image-staging не работает вовсе (fail-closed).
CRON_SECRET=
