{
  "name": "site-for-kirsan",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0 <25",
    "npm": ">=10"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run check:colors && npm run test",
    "e2e": "node --env-file-if-exists=.env.local scripts/e2e/run-playwright.mjs --build",
    "e2e:ci": "node scripts/e2e/run-playwright.mjs",
    "e2e:smoke": "node --env-file-if-exists=.env.local scripts/e2e/run-playwright.mjs --build --grep @smoke",
    "e2e:public": "node --env-file-if-exists=.env.local scripts/e2e/run-playwright.mjs --build --project=public",
    "e2e:admin": "node --env-file-if-exists=.env.local scripts/e2e/run-playwright.mjs --build --project=admin",
    "e2e:preflight": "node --env-file-if-exists=.env.local scripts/e2e/preflight.mjs",
    "e2e:install": "playwright install chromium",
    "check:colors": "node scripts/check-color-tokens.mjs",
    "schema:check": "node scripts/check-supabase-schema.mjs",
    "schema:declarative": "node scripts/check-declarative-schema.mjs",
    "photos:enhance": "node scripts/enhance-product-photos.mjs",
    "images:vehicle-webp": "node scripts/generate-vehicle-webp.mjs",
    "video:hero": "node scripts/generate-hero-video.mjs",
    "video:hero:upload": "node scripts/upload-hero-video.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@next/env": "16.2.11",
    "@sentry/nextjs": "^10.69.0",
    "@supabase/supabase-js": "^2.110.7",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "isomorphic-dompurify": "^3.23.0",
    "lucide-react": "^1.24.0",
    "next": "16.2.11",
    "postcss": "8.5.23",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.3",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
